<ui:FluentWindow x:Class="DualAudioRouter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:DualAudioRouter"
        mc:Ignorable="d"
        Title="Dual Audio Router" Height="580" Width="580"
        MinHeight="480" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Icon="app.ico"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Windows 11 TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Dual Audio Router" />

        <!-- Compact Clean Header Bar -->
        <Grid Grid.Row="1" Margin="20,0,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Audio Router"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="12"
                        Padding="8,3"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding EngineState}"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>

            <ui:Button Grid.Column="1"
                       Content="{Binding StartStopButtonText}"
                       Appearance="{Binding StartStopButtonAppearance}"
                       FontWeight="SemiBold"
                       Padding="16,8"
                       Click="BtnStartStop_Click" />
        </Grid>

        <!-- Tabs & Body Content -->
        <TabControl Grid.Row="2" Margin="20,0,20,12">
            <!-- TAB 1: CORE ROUTER -->
            <TabItem Header="Router">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <StackPanel>
                        <!-- Master Source Card -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Capture Source"
                                           FontWeight="Medium"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Margin="0,0,0,8" />

                                <ui:Button Grid.Row="0" Grid.Column="1"
                                           Content="Refresh"
                                           Appearance="Secondary"
                                           IsEnabled="{Binding IsNotRouting}"
                                           Padding="10,4"
                                           FontSize="12"
                                           Click="BtnRefresh_Click" />

                                <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                          ItemsSource="{Binding AvailableDevices}"
                                          SelectedItem="{Binding SelectedMasterDevice}"
                                          DisplayMemberPath="Name"
                                          IsEnabled="{Binding IsNotRouting}"
                                          HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>

                        <!-- Outputs Header -->
                        <Grid Margin="2,0,2,8">
                            <TextBlock Text="Output Destinations"
                                       FontWeight="Medium"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />

                            <ui:Button Content="+ Add Output"
                                       Appearance="Secondary"
                                       IsEnabled="{Binding IsNotRouting}"
                                       HorizontalAlignment="Right"
                                       Padding="12,4"
                                       FontSize="12"
                                       Click="BtnAddOutput_Click" />
                        </Grid>

                        <!-- Output Rows List -->
                        <ItemsControl ItemsSource="{Binding OutputRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <!-- Top Row: Badge, Device selector, Mute, Remove -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IndexLabel}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="White" />
                                                </Border>

                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding Devices}"
                                                          SelectedItem="{Binding SelectedDevice}"
                                                          DisplayMemberPath="Name"
                                                          IsEnabled="{Binding DataContext.IsNotRouting, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                          HorizontalAlignment="Stretch"
                                                          Margin="0,0,8,0" />

                                                <ui:Button Grid.Column="2"
                                                           Content="{Binding MuteButtonText}"
                                                           Appearance="{Binding MuteButtonAppearance}"
                                                           FontSize="12"
                                                           Padding="10,4"
                                                           Click="BtnMute_Click"
                                                           Margin="0,0,6,0" />

                                                <ui:Button Grid.Column="3"
                                                           Content="✕"
                                                           Appearance="Transparent"
                                                           FontSize="12"
                                                           Padding="8,4"
                                                           IsEnabled="{Binding DataContext.IsNotRouting, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                           Click="BtnRemoveOutput_Click" />
                                            </Grid>

                                            <!-- Bottom Row: Volume Slider & Bass Boost -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding VolumeLabel}"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Width="62" />

                                                <Slider Grid.Column="1"
                                                        Minimum="0" Maximum="100"
                                                        Value="{Binding Volume, Mode=TwoWay}"
                                                        VerticalAlignment="Center"
                                                        Margin="4,0,14,0" />

                                                <ui:ToggleSwitch Grid.Column="2"
                                                                 Content="Bass Boost"
                                                                 FontSize="12"
                                                                 IsChecked="{Binding BassBoost, Mode=TwoWay}"
                                                                 VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: ADVANCED CONTROLS -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <StackPanel>
                        <!-- Latency Card -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Buffer Latency"
                                           FontWeight="Medium"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Margin="0,0,0,6" />
                                <ComboBox SelectedIndex="{Binding SelectedLatencyIndex}"
                                          IsEnabled="{Binding IsNotRouting}">
                                    <ComboBoxItem Content="Ultra Low (10ms) — Wired IEMs &amp; Gaming" />
                                    <ComboBoxItem Content="Balanced (20ms) — Standard Recommended" />
                                    <ComboBoxItem Content="Stable (50ms) — Bluetooth &amp; Wireless" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Delay Card -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Sync Offset Delay"
                                               FontWeight="Medium"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding SyncDelayMs, StringFormat='{}{0} ms'}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Minimum="0" Maximum="300"
                                        TickFrequency="25"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding SyncDelayMs, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Toggles Card -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <ui:ToggleSwitch Content="Clock Drift Compensation"
                                                     FontSize="13"
                                                     FontWeight="Medium"
                                                     IsChecked="{Binding ClockDrift, Mode=TwoWay}"
                                                     Margin="0,0,0,3" />
                                    <TextBlock Text="Automatically resamples audio buffers to prevent pops/clicks caused by mismatched DAC clock frequencies."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="48,0,0,0" />
                                </StackPanel>

                                <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,10" />

                                <StackPanel>
                                    <ui:ToggleSwitch Content="WASAPI Exclusive Mode"
                                                     FontSize="13"
                                                     FontWeight="Medium"
                                                     IsChecked="{Binding ExclusiveMode, Mode=TwoWay}"
                                                     IsEnabled="{Binding IsNotRouting}"
                                                     Margin="0,0,0,3" />
                                    <TextBlock Text="Bypasses Windows Audio mixer for direct hardware stream access and lower latency."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="48,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: AUDIO MONITOR -->
            <TabItem Header="Monitor">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="Real-Time Peak Levels"
                                       FontWeight="Medium"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,12" />

                            <!-- Left Channel -->
                            <StackPanel Margin="0,0,0,10">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Left (L)" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LeftPeakDbfs}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" />
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="100"
                                             Value="{Binding LeftPeakPercent}"
                                             Height="10"
                                             Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            </StackPanel>

                            <!-- Right Channel -->
                            <StackPanel Margin="0,0,0,12">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Right (R)" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RightPeakDbfs}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" />
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="100"
                                             Value="{Binding RightPeakPercent}"
                                             Height="10"
                                             Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            </StackPanel>

                            <TextBlock Text="{Binding MonitorStreamDetails}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Compact Bottom Status -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />

                <TextBlock Text="DualAudioRouter"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
